---
interface Props {
  id: string;
  title: string;
  iconUrl: string;
}
const { id, title, iconUrl } = Astro.props;
---

<button class="desktop-icon flex flex-col items-center justify-center w-24 p-2 rounded cursor-pointer hover:bg-blue-500/20 text-white text-center select-none" data-opens={id}>
  <div class="relative w-12 h-12 mb-1">
    <img src={iconUrl} alt={title} class="w-full h-full object-contain" />
    <div class="absolute bottom-0 left-0 w-4 h-4 bg-white/80 border border-gray-400 flex items-center justify-center text-[8px] text-black font-bold">➔</div>
  </div>
  <span class="text-xs drop-shadow-[1px_1px_1px_rgba(0,0,0,1)] text-shadow font-mono tracking-wide">{title}</span>
</button>

<style>

  .desktop-icon span {
    text-shadow: 1px 1px 1px #000;
  }
</style>
