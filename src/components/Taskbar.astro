---
<div class="retro-outset fixed bottom-0 left-0 right-0 h-12 bg-[#dfdfdf] z-50 flex items-center justify-between px-2 select-none">
  <div class="flex items-center gap-2 h-full py-1">
    <button class="retro-outset flex items-center gap-1 font-bold px-3 h-full bg-[#dfdfdf] hover:bg-gray-300 active:border-black">
      <span class="text-blue-800 font-black">⊞</span> $TART
    </button>
    
    <div class="h-full w-[2px] bg-gray-400 mx-1"></div>
    
    <div id="taskbar-apps" class="flex gap-1 h-full">
      </div>
  </div>

  <div class="retro-inset px-3 py-1 flex items-center gap-3 text-xs bg-[#dfdfdf] font-mono text-black">
    <span>🔋 69%</span>
    <span>📶</span>
    <span id="system-clock">00:00 AM</span>
  </div>
</div>

<script>

  function updateClock() {
    const clockEl = document.getElementById('system-clock');
    if (clockEl) {
      const now = new Date();
      clockEl.innerText = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
  }
  setInterval(updateClock, 1000);
  updateClock();
</script>
