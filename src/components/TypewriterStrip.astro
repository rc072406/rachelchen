---
---
<div class="typewriter-strip">
	<div class="typewriter-box">
		<span class="typewriter-text"></span><span class="cursor">|</span>
	</div>
</div>

<script>
	const typewriterText = document.querySelector('.typewriter-text');
	const phrases = ["Do you think you're better off alone?", "What you lack is this", "Thought you'd like it"];
	let phraseIndex = 0;
	let letterIndex = 0;
	let isDeleting = false;

	function playTypewriter() {
		if (!typewriterText) return;
		const currentPhrase = phrases[phraseIndex];

		if (isDeleting) {
			typewriterText.textContent = currentPhrase.substring(0, letterIndex - 1);
			letterIndex--;
		} else {
			typewriterText.textContent = currentPhrase.substring(0, letterIndex + 1);
			letterIndex++;
		}

		let typeSpeed = isDeleting ? 40 : 80;

		if (!isDeleting && letterIndex === currentPhrase.length) {
			typeSpeed = 2500; 
			isDeleting = true;
		} else if (isDeleting && letterIndex === 0) {
			isDeleting = false;
			phraseIndex = (phraseIndex + 1) % phrases.length;
			typeSpeed = 600; 
		}

		setTimeout(playTypewriter, typeSpeed);
	}
	
	document.addEventListener('DOMContentLoaded', playTypewriter);
</script>

<style>
	.typewriter-strip {
		background: #000000;
		color: #ffffff;
		width: 100%;
		padding: 2rem;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 2; 
	}

	.typewriter-box {
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		font-size: 1.25rem;
		font-weight: 400;
		letter-spacing: -0.01em;
	}

	.cursor {
		font-weight: 300;
		margin-left: 2px;
		animation: blink 0.8s infinite steps(2, start);
	}

	@keyframes blink {
		to { visibility: hidden; }
	}
</style>
