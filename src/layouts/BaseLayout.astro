---
// src/layouts/BaseLayout.astro
import WaterBackground from '../components/WaterBackground.astro';
import Typewriter from '../components/Typewriter.astro'; // Importing your existing component

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500&family=STIX+Two+Text:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
	</head>
	<body>
		<WaterBackground />

		<div class="page-content-layer">
			
			<div class="hero-container">
				<Typewriter />
			</div>
			
			<main class="main-content">
				<slot />
			</main>

		</div>
	</body>
</html>

<style is:global>
	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background-color: #000;
		overflow-x: hidden;
		font-family: 'Plus Jakarta Sans', sans-serif;
	}

	.page-content-layer {
		position: relative;
		z-index: 2;
		width: 100%;
	}

	.hero-container {
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none; 
	}
	
	.main-content {
		position: relative;
		z-index: 3;
		width: 100%;
		min-height: 100vh;
		
	}
</style>
