---
// src/layouts/BaseLayout.astro
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rachel's Portfolio</title>
    
    <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    
    <style is:global>
        :root {
            font-family: Inter, sans-serif;
            font-feature-settings: 'liga' 1, 'calt' 1; 
            background-color: #ffffff; 
            color: #000000; 
        }
        @supports (font-variation-settings: normal) {
            :root { font-family: InterVariable, sans-serif; }
        }
        body {
            margin: 0;
            padding: 0;
            overflow-x: hidden; 
        }
        .main-footer {
            display: flex;
            justify-content: space-between;
            padding: 2rem 0;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .fade-section {
            height: 100vh; 
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            opacity: 0; 
           
        }

        .large-text {
            font-size: 4rem;
            font-weight: 700;
            letter-spacing: -0.02em; 
            margin: 0;
            perspective: 1000px; 
 
        }

       
        .char {
            display: inline-block;
            will-change: transform, opacity;
        }

        @media (max-width: 768px) {
            .main-footer {
                flex-direction: column;
                gap: 1rem;
            }
        }
    </style>
</head>
<body>
    <slot />
    
    <footer class="main-footer container">
        <p>© Rachel Chen 2026</p>
        <p>Available for projects</p>
        <a href="mailto:"><p>Email me, maybe?</p></a>
        <a href={`${import.meta.env.BASE_URL}/about`}><p>About</p></a>
        <a href={`${import.meta.env.BASE_URL}/work`}><p>Work</p></a>
    </footer>
</body>
</html>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import SplitType from "split-type";

    gsap.registerPlugin(ScrollTrigger);

    const sections = gsap.utils.toArray('.fade-section');

    sections.forEach((section: any) => {
        const textElement = section.querySelector('.large-text');
        
     
        if (!textElement) return;

   
        const splitText = new SplitType(textElement, { types: 'chars' });

    
        gsap.to(section, {
            scrollTrigger: {
                trigger: section,
                start: "top 80%", 
                end: "center center", 
                scrub: true, 
            },
            opacity: 1,
            ease: "none"
        });

      
        gsap.to(splitText.chars, {
            scrollTrigger: {
                trigger: section,
                start: "center center", 
                end: "bottom 20%", 
                scrub: true,
            },
            opacity: 0,
    
            x: "random(-200, 200)", 
            y: "random(-200, 200)",
            z: "random(-500, 500)",
            rotationX: "random(-180, 180)",
            rotationY: "random(-180, 180)",
            rotationZ: "random(-90, 90)",
            scale: "random(0, 0.5)", 
            stagger: {
                amount: 0.5,
                from: "random" 
            },
            ease: "power2.inOut"
        });
    });
</script>
