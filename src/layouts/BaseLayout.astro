---
interface Props {
	title: string;
}

const { title } = Astro.props;

---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500&family=STIX+Two+Text:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="full-page-water-system" id="interactive-banner">
			<canvas id="canvas" class="water-canvas"></canvas>
		</div>

		<div class="page-content-layer">
			<slot />
		</div>

		<script>
			import { gsap } from 'gsap';
			import * as PIXI from 'pixi.js';

			const banner = document.getElementById('interactive-banner');
			const canvas = document.querySelector("#canvas") as HTMLCanvasElement;

			if (banner && canvas) {
				const width = window.innerWidth;
				const height = window.innerHeight;

				const app = new PIXI.Application({
					view: canvas,
					width: width,
					height: height,
					backgroundAlpha: 0,
					resolution: Math.min(window.devicePixelRatio || 1, 2),
					autoDensity: true
				});

				async function initWaterEffect() {
					try {
						const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, ''); 

						
						const [waterTexture, displacementTexture, rippleTexture] = await Promise.all([
							PIXI.Assets.load(`${baseUrl}/images/rachelpond.webp`),
							PIXI.Assets.load(`${baseUrl}/images/displacement.jpg`),
							PIXI.Assets.load(`${baseUrl}/images/ripple.png`)
						]);
						
						const container = new PIXI.Container();
						app.stage.addChild(container);

						const bg = new PIXI.Sprite(waterTexture);
						bg.anchor.set(0.5);
						bg.position.set(width / 2, height / 2);
						
						const resizeBg = () => {
							const w = window.innerWidth;
							const h = window.innerHeight;
							const bgRatio = bg.texture.width / bg.texture.height;
							const bannerRatio = w / h;

							if (bannerRatio > bgRatio) {
								bg.width = w;
								bg.height = w / bgRatio;
							} else {
								bg.height = h;
								bg.width = h * bgRatio;
							}
						};

						resizeBg();
						container.addChild(bg);

						const ripples: PIXI.Sprite[] = [];
						const filters: PIXI.Filter[] = [];

						const displacementSprite = new PIXI.Sprite(displacementTexture);
						
						if (displacementSprite.texture.baseTexture) {
							displacementSprite.texture.baseTexture.wrapMode = PIXI.WRAP_MODES.REPEAT;
						}
						
						displacementSprite.scale.set(1);
						displacementSprite.anchor.set(0);
						app.stage.addChild(displacementSprite);

						const displacementFilter = new PIXI.filters.DisplacementFilter(displacementSprite);
						displacementFilter.scale.x = 10;
						displacementFilter.scale.y = 10;
						filters.push(displacementFilter);

						for (let i = 0; i < 10; i++) {
							const ripple = new PIXI.Sprite(rippleTexture);
							ripple.anchor.set(0.5);
							ripple.scale.set(0);
							app.stage.addChild(ripple);
							
							const filter = new PIXI.filters.DisplacementFilter(ripple);
							filters.push(filter);
							ripples.push(ripple);
						}

						app.stage.filters = filters;

						gsap.to(displacementSprite.anchor, {
							y: "-2",
							x: "-1",
							duration: 44,
							ease: "none",
							repeat: -1
						});

						let rippleIndex = -1;
						let lastTargetTime = 0;

					
						window.addEventListener('pointermove', function(ev) {
							const now = performance.now();
							if (now - lastTargetTime < 50) return; 
							lastTargetTime = now;

							rippleIndex = (rippleIndex + 1) % 10;
							
							const x = ev.clientX;
							const y = ev.clientY;
							
							ripples[rippleIndex].position.set(x, y);
							
							gsap.killTweensOf(ripples[rippleIndex].scale);
							gsap.killTweensOf(filters[rippleIndex + 1].scale);
							
							gsap.fromTo(ripples[rippleIndex].scale, { x: 0.1, y: 0.1 }, { x: 2.5, y: 2.5, duration: 3.5, ease: "power2.out" });
							gsap.fromTo(filters[rippleIndex + 1].scale, { x: 60, y: 60 }, { x: 0, y: 0, duration: 3.5, ease: "power2.out" });
						}, { passive: true });

						window.addEventListener('resize', () => {
							const w = window.innerWidth;
							const h = window.innerHeight;
							app.renderer.resize(w, h);
							bg.position.set(w / 2, h / 2);
							resizeBg();
						});

					} catch (error) {
						console.error(error);
					}
				}

				initWaterEffect();
			}
		</script>
	</body>
</html>

<style is:global>

	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background-color: #000;
		overflow-x: hidden;
	}

	.full-page-water-system {
		position: fixed; 
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		z-index: 1;
		pointer-events: none; 
	}

	.water-canvas {
		width: 100%;
		height: 100%;
		display: block;
	}


	.page-content-layer {
		position: relative;
		z-index: 2;
		width: 100%;
		min-height: 100vh;
	}
</style>
