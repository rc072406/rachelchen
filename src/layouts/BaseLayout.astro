---
// src/layouts/BaseLayout.astro
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rachel's Portfolio</title>
    
    <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    
    <style is:global>
   
        :root {
            font-family: Inter, sans-serif;
            font-feature-settings: 'liga' 1, 'calt' 1; 
            background-color: #ffffff; 
            color: #000000; 
        }
        @supports (font-variation-settings: normal) {
            :root { font-family: InterVariable, sans-serif; }
        }
        body {
            margin: 0;
            padding: 0;
            overflow-x: hidden; 
        }
.main-footer {
		display: flex;
		justify-content: space-between;
		padding: 2rem 0;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
 .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .fade-section {
        height: 100vh; 
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        opacity: 0.1; 
        transform-origin: center center;
        
       
        will-change: transform, opacity;
        backface-visibility: hidden; 
        transform: translateZ(0); 
        perspective: 1000px; 
    }

    .large-text {
        font-size: 4rem;
        font-weight: 700;
        letter-spacing: -0.02em; 
        margin: 0;
    }


@media (max-width: 768px) {
		
		.main-footer {
			flex-direction: column;
			gap: 1rem;
		}
	}

    </style>
</head>
<body>
    <slot />
<footer class="main-footer">
				<p>© Rachel Chen 2026</p>
				<p>Available for projects</p>
           <a href="mailto:"><p>Email me, maybe?</p></a>
           <a href={`${import.meta.env.BASE_URL}/about`}><p>About</p></a>
            <a href={`${import.meta.env.BASE_URL}/work`}><p>Work</p></a>
			</footer>
</body>

</html>
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const sections = gsap.utils.toArray('.fade-section');

    sections.forEach((section) => {
        
       
        gsap.to(section, {
            scrollTrigger: {
                trigger: section,
                start: "top 80%", 
                end: "center center", 
                scrub: true, 
            },
            opacity: 1,
            y: -30, 
            scale: 1, 
            ease: "none"
        });

      
        gsap.to(section, {
            scrollTrigger: {
                trigger: section,
                start: "center center", 
                end: "bottom 20%", 
                scrub: true,
            },
            opacity: 0,
            y: -60, 
            scale: 0.75, 
            ease: "none"
        });
    });
</script>
