---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---


<BaseLayout>
    <main class="container">
        <section class="fade-section">
            <h1 class="large-text">This is the story</h1>
        </section>

        <section class="fade-section">
            <p class="large-text">...of a girl</p>
        </section>

        <section class="fade-section">
            <p class="large-text">that started to code...</p>
        </section>
        
        <section class="fade-section">
            <p class="large-text">...then her dreams came true.</p>
        </section>
        
        <section class="fade-section">
            <p class="large-text">And now she helps yours come true too.</p>
        </section>
        
       
    </main>
</BaseLayout>
