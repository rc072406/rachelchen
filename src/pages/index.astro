---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <main class="container">
        <section class="fade-section">
            <h1 class="large-text">Hello, I am Rachel</h1>
        </section>

        <section class="fade-section">
            <p class="large-text">I don't just build websites. I create emotional experiences.</p>
        </section>

        <section class="fade-section">
            <p class="large-text">Whether I'm taking you to space or a futuristic pink city...or even your therapist's office, you will be immersed.</p>
        </section>
        
        <section class="fade-section">
            <p class="large-text">Because it's not just websites I'm making...</p>
        </section>
        
        <section class="fade-section">
            <p class="large-text">I'm architecting visual and emotional stories that transcend beyond basic user interface and user experience.</p>
        </section>
        
        <section class="fade-section">
            <p class="large-text">So join me, and turn your website into an intergalactic rollercoaster of feelings.</p>
        </section>
    </main>
</BaseLayout>





