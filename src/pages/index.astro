---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <main class="container">
        <section class="fade-section">
            <h1 class="large-text">Hello, I am Rachel</h1>
        </section>

        <section class="fade-section">
            <p>I don't just build websites. I create emotional experiences. </p>
        </section>

        <section class="fade-section">
            <p>Whether I'm taking you to space or a futuristic pink city...or even your therapist's office, you will be immersed.</p>
        </section>
    <section class="fade-section">
            <p>Because it's not just websites I'm making...</p>
        </section>
 <section class="fade-section">
            <p>I'm architecting visual and emotional rides that transcend beyond basic user interface and user experience.</p>
        </section>
 <section class="fade-section">
            <p>So join me, and turn your website into an intergalactic rollercoaster of feelings.</p>
        </section>
    </main>
</BaseLayout>

<style>
    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .fade-section {
        height: 100vh; 
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        opacity: 0.1; 
     
        transform-origin: center center;
    }

    .large-text {
        font-size: 4rem;
        font-weight: 700;
        letter-spacing: -0.02em; 
        margin: 0;
    }

    p {
        font-size: 1.5rem;
        line-height: 1.6;
        font-weight: 400;
        margin: 0;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

   
    const sections = gsap.utils.toArray<HTMLElement>('.fade-section');

    sections.forEach((section) => {
   
        gsap.fromTo(section, 
            { 
                opacity: 0, 
                y: 50, 
                scale: 0.9 
            },
            {
                scrollTrigger: {
                    trigger: section,
                    start: "top 85%",      
                    end: "top 40%",       
                    scrub: 1,             
                },
                opacity: 1,
                y: 0,
                scale: 1,
                ease: "power1.out"
            }
        );

     
        gsap.to(section, {
            scrollTrigger: {
                trigger: section,
                start: "bottom 60%",   
                end: "bottom 20%",   
                scrub: 1,             
            },
            opacity: 0,
            y: -50,
            scale: 0.9,
            ease: "power1.in"
        });
    });
</script>
