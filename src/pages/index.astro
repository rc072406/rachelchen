---
import Layout from '../layouts/Layout.astro';
import TypewriterStrip from '../components/TypewriterStrip.astro';
import RachelPondFooter from '../components/RachelPondFooter.astro';
---

<Layout title="Rachel's Pond | Creative Portfolio">
	
	<main class="main-site-content" transition:animate="fade">
		
		<section class="hero-section">
			<div class="content-box reveal" >
				<h1 >Rachel's Pond</h1>
				<p>Welcome to the pond where me and my team of ducks help bring <em>your</em> dreams to life.</p>
			</div>
		</section>
<section class="about-section">
	<div class="content-box reveal">
		<p class="about-text" >
		Here at the Pond, we advocate for trauma minded and environment friendly design. Disillusioned with the current climate in technology, we've created spaces for others to feel safe and welcomed. We don't follow trends at the Pond, and won't ever. 
		</p>

<p class= "about-text">
Ever dreamed of flying in space or visiting a futuristic pink city? We create dream worlds that transcend basic user interface and experience. Let's splash. 
<p>
	</div>
</section>

		<section class="work-section">
			<div class="content-box reveal">
				<h2>Selected Archive</h2>
				<div class="placeholder-grid">
					<div class="grid-item">Project One</div>
					<div class="grid-item">Project Two</div>
					<div class="grid-item">Project Three</div>
				</div>
			</div>
		</section>
<section class="blank-section">
	<div class="content-box footer-row">
		<div class="copyright-info">
			<p>&copy; {new Date().getFullYear()} Rachel's Pond. All rights reserved.</p>
		</div>
		<div class="social-links">
			<a href="" target="_blank" rel="noopener noreferrer">LinkedIn</a>
			<a href="" target="_blank" rel="noopener noreferrer">Instagram</a>
		</div>
	</div>
</section>
		<TypewriterStrip />
		
	</main>

	<RachelPondFooter />

</Layout>

<style>

	.main-site-content {
		position: relative;
		z-index: 2; 
		background: #ffffff; 
		color: #111111;
		min-height: 100vh;
		

		box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5); 
	}


	.content-box {
		max-width: 1100px;
		margin: 0 auto;
		width: 100%;
	}

	section {
		padding: 8rem 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.hero-section {
		min-height: 80vh;
		background: #fdfdfd;
	}

	.hero-section h1 {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
	  font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin-bottom: 1.5rem;
	}

	.hero-section p {
		font-size: clamp(1.1rem, 2vw, 1.5rem);
		color: #666;
		max-width: 600px;
	}

	.work-section {
		background: #f7f7f7;
		border-top: 1px solid #eaeaea;
	}

	.work-section h2 {
	  font-size: clamp(2.5rem, 6vw, 4.5rem);
	  font-weight: 400;
		margin-bottom: 3rem;
		letter-spacing: -0.02em;
	}

	.placeholder-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.grid-item {
		background: #ffffff;
		border: 1px solid #e0e0e0;
		height: 400px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 500;
		color: #888;
		transition: transform 0.3s ease;
	}

	.grid-item:hover {
		transform: translateY(-4px);
		color: #111;
	}
.about-section {
	background: #111111;
	color: #ffffff;
	border-top: 1px solid #222222;
	border-bottom: 1px solid #222222;
}

.about-text {
	font-size: 2rem;
	line-height: 1.7;
	max-width: 800px;
}
.blank-section {
	background: #f7f7f7;
	min-height: 20vh; 
	border-bottom: 1px solid #eaeaea;
	display: flex;
	align-items: center;
}

.footer-row {
	display: flex;
	justify-content: space-between; 
	align-items: center;
	width: 100%;
	font-size: 0.95rem;
	color: #666666;
}

.social-links {
	display: flex;
	gap: 2rem; /
}

.social-links a {
	color: #111111;
	text-decoration: none;
	font-weight: 500;
	transition: color 0.2s ease;
}

.social-links a:hover {
	color: #666666; 
}
@media (max-width: 768px) {
	
.footer-row {
		flex-direction: column;
		gap: 1.5rem;
		text-align: center;
		justify-content: center;
	}
	
	.blank-section {
		min-height: 25vh;
	}
	}
</style>
