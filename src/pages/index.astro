---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <main class="container">
        <section class="fade-section">
            <h1 class="large-text">Hello, I am Rachel</h1>
        </section>

        <section class="fade-section">
            <p>I don't just build websites. I create emotional experiences.</p>
        </section>

        <section class="fade-section">
            <p>Whether I'm taking you to space or a futuristic pink city...or even your therapist's office, you will be immersed.</p>
        </section>
        
        <section class="fade-section">
            <p>Because it's not just websites I'm making...</p>
        </section>
        
        <section class="fade-section">
            <p>I'm architecting visual and emotional stories that transcend beyond basic user interface and user experience.</p>
        </section>
        
        <section class="fade-section">
            <p>So join me, and turn your website into an intergalactic rollercoaster of feelings.</p>
        </section>
    </main>
</BaseLayout>

<style>
  


    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .fade-section {
        height: 100vh; 
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        opacity: 0; 
        transform-origin: center center;
        
        will-change: transform, opacity, filter;
        backface-visibility: hidden; 
        transform: translateZ(0); 
        perspective: 1000px; 
    }

    .large-text {
        font-size: 4.5rem;
        font-weight: 700;
        letter-spacing: 0.2em; 
        margin: 0;
        color: #000000;
    }

    p {
        font-size: 1.65rem;
        line-height: 1.6;
        font-weight: 400;
        letter-spacing: 0.15em; 
        margin: 0;
        color: #111111; 
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const sections = gsap.utils.toArray('.fade-section');

    sections.forEach((section) => {
    
        gsap.set(section, { 
            opacity: 0, 
            y: 40, 
            filter: "blur(15px)",
            letterSpacing: "0.25em"
        });

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: section,
                start: "top 85%",      
                end: "bottom 15%",     
                scrub: 1.6,            
            }
        });

   
        tl.to(section, {
            opacity: 1,
            y: 0,
            filter: "blur(0px)",       
            letterSpacing: "-0.01em",  
            ease: "power2.out",
            duration: 1.5
        })
       
        .to(section, {
            duration: 2 
        })
      
        .to(section, {
            opacity: 0,
            y: -40,
            filter: "blur(15px)",      
            letterSpacing: "0.1em",    
            ease: "power2.in",
            duration: 1.5
        });
    });
</script>
