---
import Layout from '../layouts/Layout.astro';
import TypewriterStrip from '../components/TypewriterStrip.astro';
import RachelPondFooter from '../components/RachelPondFooter.astro';
---

<Layout title="Rachel's Pond | Creative Portfolio">
	
	<main class="main-site-content" transition:animate="fade">
		
		<section class="hero-section">
			<div class="content-box reveal" >
				<h1 >Rachel's Pond</h1>
				<p>Welcome to the pond where me and my team of ducks help bring <em>your</em> dreams to life.</p>
			</div>
		</section>
<section class="about-section">
	<div class="content-box reveal">
		<p class="about-text" >
		Here at the Pond, we advocate for trauma minded and environment friendly design. Disillusioned with the current climate in technology, we've created spaces for others to feel safe and welcomed. We don't follow trends at the Pond, and won't ever. 
		</p>

<p class= "about-text">
Ever dreamed of flying in space or visiting a futuristic pink city? We create dream worlds that transcend basic user interface and experience. Let's splash. 
<p>
	</div>
</section>
<section class="work-section">
    <div class="content-box reveal">
        <h2>Projects</h2>
        <div class="projects-list">
            
            <!-- Project 1 -->
            <div class="project-item">
                <h3>Pink Coding Club</h3>
                <p>My non-profit coding camp for non-binary youth and girls. Taught through the arts and fashion.</p>
                <div class="project-links">
                    <a href="https://pinkcodingclub.com" target="_blank" rel="noopener noreferrer">Website ↗</a>
                    <a href="https://github.com/rc072406/pinkcodingclub/" target="_blank" rel="noopener noreferrer">Source ↗</a>
                     <a href="" target="_blank" rel="noopener noreferrer">Thoughts ↗</a>
                    <div class="badges">
                        <span class="badge">Astro</span>
                        <span class="badge">TypeScript</span>
                    </div>
                </div>
            </div>

            <!-- Project 2 -->
            <div class="project-item">
                <h3>Misa Chien's Personal Site</h3>
                <p>A personal website for entrepreneur Misa Chien.</p>
                <div class="project-links">
                    <a href="https://misachien.com" target="_blank" rel="noopener noreferrer">Website ↗</a>
                    <a href="https://github.com/rc072406/misachien" target="_blank" rel="noopener noreferrer">Source ↗</a>
                    <a href="" target="_blank" rel="noopener noreferrer">Thoughts ↗</a>
                    <div class="badges">
                        <span class="badge">Astro</span>
                        <span class="badge">Javascript</span>
        
                    </div>
                </div>
            </div>

            <!-- Project 3 -->
            <div class="project-item">
                <h3>Rachel's Education Philosophy</h3>
                <p>My personal take on how the people should be taught any subject. Viewed through the literary concept of intertextuality.</p>
                <div class="project-links">
                <a href="https://rc072406.github.io/myeducationphilosophy/" target="_blank" rel="noopener noreferrer">Website ↗</a>
                    <a href="https://github.com/rc072406/myeducationphilosophy" target="_blank" rel="noopener noreferrer">Source ↗</a>
                    <a href="" target="_blank" rel="noopener noreferrer">Thoughts ↗</a>
                    <div class="badges">
                        <span class="badge">HTML</span>
                        <span class="badge">CSS</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
		
<section class="blank-section">
	<div class="content-box footer-row">
		<div class="copyright-info">
			<p>&copy; {new Date().getFullYear()} Rachel's Pond. All rights reserved.</p>
		</div>
		<div class="social-links">
			<a href="https://github.com/rc072406" target="_blank" rel="noopener noreferrer">Github</a>
			<a href="" target="_blank" rel="noopener noreferrer">I don't have social media</a>
		</div>
	</div>
</section>
		<TypewriterStrip />
		
	</main>

	<RachelPondFooter />

</Layout>

<style>

	.main-site-content {
		position: relative;
		z-index: 2; 
		background: #ffffff; 
		color: #111111;
		min-height: 100vh;
		

		box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5); 
	}


	.content-box {
		max-width: 1100px;
		margin: 0 auto;
		width: 100%;
	}

	section {
		padding: 8rem 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.hero-section {
		min-height: 80vh;
		background: #fdfdfd;
	}

	.hero-section h1 {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
	  font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin-bottom: 1.5rem;
	}

	.hero-section p {
		font-size: clamp(1.1rem, 2vw, 1.5rem);
		color: #666;
		max-width: 600px;
	}

	.work-section {
		background: #f7f7f7;
		border-top: 1px solid #eaeaea;
	}

	.work-section h2 {
	  font-size: clamp(2.5rem, 6vw, 4.5rem);
	  font-weight: 400;
		margin-bottom: 3rem;
		letter-spacing: -0.02em;
	}

.projects-list {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
		max-width: 800px;
	}

	.project-item h3 {
		font-size: 1.5rem;
		font-weight: 500;
		margin-bottom: 0.75rem;
		color: #111111;
		letter-spacing: -0.01em;
	}

	.project-item p {
		font-size: 1.1rem;
		color: #555555;
		line-height: 1.6;
		margin-bottom: 1.25rem;
	}

	.project-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.project-links a {
		color: #3b3086; 
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		transition: opacity 0.2s ease;
	}

	.project-links a:hover {
		opacity: 0.7;
		text-decoration: underline;
	}

	.badges {
		display: flex;
		gap: 0.5rem;
		margin-left: auto; 
	}

	.badge {
		background: #e9ecef;
		color: #495057;
		padding: 0.25rem 0.65rem;
		border-radius: 4px;
		font-size: 0.85rem;
		font-weight: 500;
	}

	.grid-item:hover {
		transform: translateY(-4px);
		color: #111;
	}
.about-section {
	background: #111111;
	color: #ffffff;
	border-top: 1px solid #222222;
	border-bottom: 1px solid #222222;
}

.about-text {
	font-size: 2rem;
	line-height: 1.7;
	max-width: 800px;
}
.blank-section {
	background: #f7f7f7;
	min-height: 20vh; 
	border-bottom: 1px solid #eaeaea;
	display: flex;
	align-items: center;
}

.footer-row {
	display: flex;
	justify-content: space-between; 
	align-items: center;
	width: 100%;
	font-size: 0.95rem;
	color: #666666;
}

.social-links {
	display: flex;
	gap: 2rem; /
}

.social-links a {
	color: #111111;
	text-decoration: none;
	font-weight: 500;
	transition: color 0.2s ease;
}

.social-links a:hover {
	color: #666666; 
}
@media (max-width: 600px) {
		.badges {
			margin-left: 0; 
		}
	}
@media (max-width: 768px) {
	
.footer-row {
		flex-direction: column;
		gap: 1.5rem;
		text-align: center;
		justify-content: center;
	}
	
	.blank-section {
		min-height: 25vh;
	}
	}
</style>
