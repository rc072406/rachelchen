---
import Layout from '../layouts/Layout.astro';
import TypewriterStrip from '../components/TypewriterStrip.astro';
import RachelPondFooter from '../components/RachelPondFooter.astro';
---

<Layout title="Sorry | The Pond">
	
	<main class="main-site-content" transition:animate="fade">
		
		<section class="hero-section">
			<div class="content-box reveal" >
				<h1 >We're Sorry</h1>
				<p>We prohibit team members from self promotion. If you come across any incidences please <a href={`${import.meta.env.BASE_URL}/contact`} style="text-decoration:none; color: grey; ">report.</a> Thank you for your diligence.</p>
			</div>
		</section>
<section class="blank-section">
	<div class="content-box footer-row">
		<div class="copyright-info">
			<p>&copy; {new Date().getFullYear()} Rachel's Pond. All rights reserved.</p>
		</div>
		<div class="social-links">
			<a href="" target="_blank" rel="noopener noreferrer">LinkedIn</a>
			<a href="" target="_blank" rel="noopener noreferrer">Instagram</a>
		</div>
	</div>
</section>



		<TypewriterStrip />
		
	</main>

	<RachelPondFooter />

</Layout>

<style>

	.main-site-content {
		position: relative;
		z-index: 2; 
		background: #ffffff; 
		color: #111111;
		min-height: 80vh;
		

		box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5); 
	}


	.content-box {
		max-width: 1100px;
		margin: 0 auto;
		width: 100%;
	}

	section {
		padding: 8rem 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.hero-section {
		min-height: 80vh;
		background: #fdfdfd;
	}

	.hero-section h1 {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
	  font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin-bottom: 1.5rem;
	}

	.hero-section p {
		font-size: clamp(1.1rem, 2vw, 1.5rem);
		color: #666;
		max-width: 600px;
	}
.blank-section {
	background: #f7f7f7;
	min-height: 20vh; 
	border-bottom: 1px solid #eaeaea;
	display: flex;
	align-items: center;
}

.footer-row {
	display: flex;
	justify-content: space-between; 
	align-items: center;
	width: 100%;
	font-size: 0.95rem;
	color: #666666;
}

.social-links {
	display: flex;
	gap: 2rem; /
}

.social-links a {
	color: #111111;
	text-decoration: none;
	font-weight: 500;
	transition: color 0.2s ease;
}

.social-links a:hover {
	color: #666666; 
}
@media (max-width: 768px) {
	
.footer-row {
		flex-direction: column;
		gap: 1.5rem;
		text-align: center;
		justify-content: center;
	}
	
	.blank-section {
		min-height: 25vh;
	}
	}

</style>
